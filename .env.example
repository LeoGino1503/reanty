# Copy to .env and change the passwords/token before running.
MONGO_ROOT_USER=reanty
MONGO_ROOT_PASSWORD=replace-with-a-strong-password
MONGO_URL=mongodb://reanty:replace-with-a-strong-password@localhost:27017/reanty?authSource=admin
MONGO_DB=reanty
MINIO_ROOT_USER=reantyadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=reantyadmin
MINIO_SECRET_KEY=replace-with-a-strong-password
MINIO_BUCKET=reanty-media
MINIO_SECURE=false
ADMIN_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_MB=50
VITE_API_BASE=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000
